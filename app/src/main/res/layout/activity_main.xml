<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/text_nfc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Estado NFC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ID de Usuario (manual):"
        android:textSize="14sp"/>

    <EditText
        android:id="@+id/edittext_user_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduce ID"
        android:inputType="number"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/text_selected_user_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👤 Usuario: -"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/button_clock_in"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ENTRADA MANUAL"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/button_clock_out"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SALIDA MANUAL"/>
    </LinearLayout>

    <!-- 👇 NUEVO BOTÓN DE ADMINISTRACIÓN -->
    <Button
        android:id="@+id/button_admin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👑 ADMIN: Asignar tarjetas NFC"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="O usa tu tarjeta NFC para fichar"
        android:textAlignment="center"
        android:textStyle="italic"
        android:textSize="14sp"/>

</LinearLayout>